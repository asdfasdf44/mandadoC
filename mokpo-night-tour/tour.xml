<krpano version="1.24" title="Virtual Tour">

	<include url="skin/vtourskin.xml" />

	<style name="skin_hotspotstyle" onclick="tour_approach_hotspot();" />
	<layer name="skin_tooltip" bgcolor="0x141B30" bgalpha="0.9" bgroundedge="10"
	       oy="-18" padding="8 12" width="220" />

	<style name="tour_external_hotspot" edge="center" renderer="webgl" distorted="false"
	       scale="0.5" onover="tween(scale, 0.55, 0.16);" onout="tween(scale, 0.5, 0.16);"
	       onclick="tour_open_external_link();" />

	<action name="tour_open_external_link" scope="local">
		spheretoscreen(get(caller.ath), get(caller.atv), label_x, label_y);
		set(layer[skin_tooltip], html=get(caller.tooltip), x=get(label_x), y=get(label_y),
		    visible=true, alpha=1);
		delayedcall(tour_external_label, 1.5, skin_hidetooltips(); );
		openurl(get(caller.linkurl), _blank);
	</action>

	<action name="tour_approach_hotspot" scope="local">
		set(caller.enabled, false);
		skin_hidetooltips();
		spheretoscreen(get(caller.ath), get(caller.atv), hotspot_x, hotspot_y);
		zoom_x = max(0, min(1, (hotspot_x + caller.ox) / stagewidth));
		zoom_y = max(0, min(1, (hotspot_y + caller.oy) / stageheight));
		skin_loadscene(get(caller.linkedscene), calc('ZOOMBLEND(0.45, 1.32, ' + zoom_x + ', ' + zoom_y + ', easeInOutSine)'));
	</action>

	<layer name="tour_back_button" type="text" keep="true" align="top" x="0" y="18"
	       width="112" height="44" zorder="100" enabled="false" alpha="0.45"
	       html="&#8592; 돌아가기" vcenter="true"
	       css="color:#FFFFFF; font-family:system-ui,sans-serif; font-size:15px; font-weight:600; text-align:center;"
	       bgcolor="0x141B30" bgalpha="0.88" bgroundedge="22" bgborder="1 0x9CEEF2 0.65"
	       bgshadow="0 3 10 0x000000 0.28"
	       onover="tween(scale, 1.04, 0.16, easeOutQuad); set(bgcolor, 0x263951);"
	       onout="tour_reset_back_hover();"
	       onclick="tour_reset_back_hover(); tour_go_back();" />

	<action name="tour_reset_back_hover" scope="local">
		tween(layer[tour_back_button].scale, 1.0, 0.16, easeOutQuad);
		set(layer[tour_back_button].bgcolor, 0x141B30);
	</action>

	<events name="tour_back_events" keep="true" onnewscene="tour_record_scene();" />

	<action name="tour_record_scene" type="Javascript"><![CDATA[
		const button = krpano.get("layer[tour_back_button]");
		const scene = krpano.get("xml.scene");
		const history = button.sceneHistory ??= [];
		if (scene === button.backtarget) {
			history.pop();
		} else if (scene && scene !== history[history.length - 1]) {
			history.push(scene);
		}
		button.backtarget = null;
		button.enabled = history.length > 1;
		button.alpha = button.enabled ? 1 : 0.45;
	]]></action>

	<action name="tour_go_back" type="Javascript"><![CDATA[
		const button = krpano.get("layer[tour_back_button]");
		const history = button.sceneHistory;
		if (!button.enabled || !history || history.length < 2) return;

		button.backtarget = history[history.length - 2];
		button.enabled = false;
		krpano.call("skin_loadscene(get(layer[tour_back_button].backtarget));");
	]]></action>

