<krpano version="1.24" title="Virtual Tour">

	<include url="skin/vtourskin.xml?v=20261014-final" />
	<action name="room0_open_navigation" type="Javascript"><![CDATA[
		if (window.openRoomNavigation) window.openRoomNavigation(krpano, caller);
	]]></action>
    <action name="room_travel_linked" type="Javascript"><![CDATA[
        if (window.travelRoomNavigation) window.travelRoomNavigation(krpano, caller);
    ]]></action>
	<action name="room0_arrow_effect" type="Javascript"><![CDATA[
		if (caller.sprite) {
			caller.sprite.classList.add('room0-navigation-icon');
			caller.sprite.setAttribute('aria-label', caller.navigationlabel || '전시관 선택');
		}
	]]></action>
	<action name="room0_arrow_pulse">
		if((xml.scene == scene_room0 OR xml.scene == scene_room1_1 OR xml.scene == scene_room1_2 OR xml.scene == scene_room2 OR xml.scene == scene_room3) AND navigationopen != true,
			tween(scale,1.12,1.4,easeInOutSine,
				tween(scale,1.0,1.4,easeInOutSine,room0_arrow_pulse());
			);
		);
	</action>
	<events name="room0_locked_view" keep="true" onnewscene="room0_set_view_lock();" onviewchange="room0_enforce_view_lock();" />
	<action name="room0_set_view_lock" type="Javascript"><![CDATA[
        krpano.set('navigationtravel', false);
        if (window.LobbyEdgeBlur) window.LobbyEdgeBlur.scene(krpano.get('xml.scene'));
		if (krpano.get('xml.scene') === 'scene_room0') {
			krpano.call('stopmovements();');
			krpano.set('control.usercontrol', 'all');
			krpano.set('control.mousewheel', false);
		} else {
			krpano.set('control.usercontrol', 'all');
			krpano.set('control.mousewheel', true);
		}
	]]></action>
	<action name="room0_enforce_view_lock" type="Javascript"><![CDATA[
		if (krpano.get('navigationtravel')) return;
		if (krpano.get('xml.scene') === 'scene_room0') {
			krpano.set('plugin[skin_gyro].enabled', false);
			var h = Number(krpano.get('view.hlookat'));
			var v = Number(krpano.get('view.vlookat'));
			var dh = ((h - 182.48786990221765 + 180) % 360 + 360) % 360 - 180;
			var dv = v - 11.652109596863058;
			var limitedH = Math.max(-5, Math.min(5, dh));
			var limitedV = Math.max(-5, Math.min(5, dv));
			if (Math.abs(dh - limitedH) > 0.000001) krpano.set('view.hlookat', h + limitedH - dh);
			if (Math.abs(dv - limitedV) > 0.000001) krpano.set('view.vlookat', v + limitedV - dv);
			krpano.set('view.fov', 120);
			krpano.set('fov_moveforce', 0);
		}
	]]></action>
	<!-- Room2 floor navigation experiment; remove this block and room2-floor includes to undo. -->
	<events name="room2_floor_navigation" keep="true"
	        onnewscene="jscall(if(window.Room2Floor) window.Room2Floor.hide());" />
	<action name="room2_floor_hover" type="Javascript"><![CDATA[
		if (window.Room2Floor) {
			krpano.call('screentosphere(mouse.x, mouse.y, room2_floor_h, room2_floor_v);');
			window.Room2Floor.hover(krpano, krpano.get('room2_floor_h'), krpano.get('room2_floor_v'), krpano.get('mouse.x'), krpano.get('mouse.y'));
		}
	]]></action>
	<action name="room2_floor_click" type="Javascript"><![CDATA[
		if (window.Room2Floor) {
			krpano.call('screentosphere(mouse.x, mouse.y, room2_floor_h, room2_floor_v);');
			window.Room2Floor.click(krpano, krpano.get('room2_floor_h'), krpano.get('room2_floor_v'));
		}
	]]></action>
	<events name="room2_background_music" keep="true" onnewscene="room2_update_bgm();" />
	<action name="room2_update_bgm" type="Javascript"><![CDATA[
		if (window.Room2BGM) window.Room2BGM.scene(krpano.get('xml.scene'));
	]]></action>
	<style name="room2_puzzle_icon" url="skin/icon.png" width="58" height="58" renderer="css3d" distorted="false" alpha="1" onloaded="room2_icon_animate();" />
	<action name="room2_icon_animate" type="Javascript"><![CDATA[
		if (caller.sprite) {
			caller.sprite.classList.add('room2-art-icon');
			if (window.Room2IconLabels) window.Room2IconLabels.attach(caller);
			var image = caller.sprite.querySelector('img') || caller.sprite;
			image.style.filter = 'drop-shadow(0 0 4px #fffbe0) drop-shadow(0 0 12px #ffd057) drop-shadow(0 0 22px #ffb52b)';
			if (image.animate) image.animate([
				{ filter: 'drop-shadow(0 0 4px #fffbe0) drop-shadow(0 0 12px #ffd057) drop-shadow(0 0 22px #ffb52b)' },
				{ filter: 'drop-shadow(0 0 6px #ffffff) drop-shadow(0 0 18px #ffe078) drop-shadow(0 0 32px #ffb52b)' },
				{ filter: 'drop-shadow(0 0 4px #fffbe0) drop-shadow(0 0 12px #ffd057) drop-shadow(0 0 22px #ffb52b)' }
			], { duration: 2400, iterations: Infinity, easing: 'ease-in-out' });
		}
	]]></action>
	<action name="room2_open_puzzle" type="Javascript" args="number"><![CDATA[
		if (window.startRoom2Puzzle) window.startRoom2Puzzle(krpano, caller, args[1]);
	]]></action>
	<action name="room2_open_artist" type="Javascript"><![CDATA[
		if (window.openRoom2Artist) window.openRoom2Artist(krpano);
	]]></action>

